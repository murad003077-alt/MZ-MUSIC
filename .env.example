# API Configuration
VITE_MUSIC_API_URL=https://api.spotify.com/v1
VITE_MUSIC_API_KEY=your_spotify_api_key
VITE_MUSIC_CLIENT_ID=your_spotify_client_id
VITE_MUSIC_CLIENT_SECRET=your_spotify_client_secret
VITE_MUSIC_REDIRECT_URI=mzmusic://auth

# Firebase Configuration (optional)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# AI Recommendations (optional)
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_api_key
